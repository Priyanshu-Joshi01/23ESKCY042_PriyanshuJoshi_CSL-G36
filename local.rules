# ==============================================================================
# Custom Snort IDS Ruleset
# Student: Priyanshu Joshi | Roll No: 23ESKCY042 | Project Code: CSL-G36
# Course: Cyber Security Lab (7CS4-22) | SKIT Jaipur
# Linked Experiment: Exp 7 - Intrusion Detection System
# ==============================================================================

# 1. TCP SYN Port Scan Detection (Threshold: 15 SYN packets in 5 seconds)
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"CUSTOM IDS ALERT: TCP SYN Port Scan Detected"; flags:S; threshold:type both, track by_src, count 15, seconds 5; classtype:attempted-recon; sid:1000001; rev:1;)

# 2. ICMP Ping Flood (DoS) Detection (Threshold: 20 ICMP Echo Requests in 2 seconds)
alert icmp $EXTERNAL_NET any -> $HOME_NET any (msg:"CUSTOM IDS ALERT: ICMP Ping Flood Detected"; itype:8; threshold:type both, track by_src, count 20, seconds 2; classtype:attempted-dos; sid:1000002; rev:1;)

# 3. SSH Brute-Force Attempt Detection (Threshold: 5 SYN connections to port 22 in 15 seconds)
alert tcp $EXTERNAL_NET any -> $HOME_NET 22 (msg:"CUSTOM IDS ALERT: Possible SSH Brute-Force Attack"; flags:S; threshold:type both, track by_src, count 5, seconds 15; classtype:attempted-admin; sid:1000003; rev:1;)

# 4. Suspicious HTTP - Directory Traversal Attempt (../)
alert tcp $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (msg:"CUSTOM IDS ALERT: Suspicious HTTP Directory Traversal Attempt"; flow:to_server,established; content:"../"; nocase; classtype:web-application-attack; sid:1000004; rev:1;)

# 5. Suspicious HTTP - SQL Injection (UNION SELECT)
alert tcp $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (msg:"CUSTOM IDS ALERT: Suspicious HTTP SQL Injection (UNION SELECT)"; flow:to_server,established; content:"UNION"; nocase; content:"SELECT"; nocase; distance:0; classtype:web-application-attack; sid:1000005; rev:1;)

# 6. Suspicious HTTP - Automated Scanner User-Agent (sqlmap / Nikto)
alert tcp $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (msg:"CUSTOM IDS ALERT: Automated Vulnerability Scanner Detected"; flow:to_server,established; pcre:"/User-Agent\x3a[^\r\n]*(sqlmap|Nikto|Nmap)/i"; classtype:attempted-recon; sid:1000006; rev:1;)
